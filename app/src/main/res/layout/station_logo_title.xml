<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="12dp" android:paddingBottom="10dp">
    <TextView android:id="@+id/logo_dialog_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/message_066" android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium" android:textSize="23sp" />
    <TextView android:id="@+id/logo_dialog_station"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="2" android:ellipsize="end"
        android:textColor="@color/text_secondary" android:textSize="16sp" />
</LinearLayout>
